-- author: OpenDMD
-- licence: CC0-1.0
name "Endless road V2: Megacity (sketch)"
about "The megacity on its own: a raised highway through two rows of towers, windows in the wet road, gantries"
loop forever
fps 50

-- A sketch of the Megacity as its own environment (not a recolour of
-- the desert road), to cost its geometry: two rows of towers at different
-- parallax (the column run), lit window grids, their lights reflected in
-- the wet road, a raised highway with barriers and the city going on
-- below it, a dashed centre line, gantries crossing the road, lit roof
-- edges, lamp posts. Flat, long bends. Fits today's limits on its own;
-- in V2 it is one `scene` of four (opendmd-notes docs/research/endless-road-v2.md).

palette c = black #000, asphalt #0e0a16, asphaltStripe #140f20, wetLit #3a2a58,
  lane #8090b0, barrier #445, barrierStripe #667, below #04020a, belowWin #3a1a50,
  farTower #3a1450, nearTower #08060e, window #90e8ff, farDay #6a7090, nearDay #3a3e58,
  neon #a040ff, gantry #556, sign #f2a, car #303850, glass #5878a8, red #ff2030,
  #05020c, #0a0418, #140626, #220a36, #380e44, #6a1658,
  #8fb4e8, #a9c6ee, #c4d8f4, #dce7f8, #efe4d8, #ffd0a0

table carSpan = 273, 242, 273, 211, 242, 118, 56, 69, 242, 663, 56, 69, 242, 663, 56, 56, 25
table carRow = 136, 120, 121, 104, 105, 88, 72, 74, 73, 74, 56, 58, 57, 58, 40, 24, 9

-- The road: flat, long bends (the city's profile)
driven = t*.15 + seed*1000
heading = noise(driven, 0, 0)
carLeft = (heading - noise(driven + .03, 0, 0))*80 - 50.99999

-- Day and night (V1's clock)
sunPhase = sin(t/240 + seed*3)
light = clamp(sunPhase*sunPhase*sunPhase*-3, -1, 1)
night = clamp(-light, 0, 1)
dark = night > .5
skyBase = dark ? 25.9 - night*2 : 31.9
skyStep = dark ? .33 : .3
farInk = dark ? c.farTower : c.farDay
nearInk = dark ? c.nearTower : c.nearDay
winInk = dark ? c.window : c.nearDay
reflInk = dark*(c.wetLit - c.asphalt)
neonInk = dark*c.neon

-- Two rows of towers turn with the road, the near one faster
nearShift = heading*-90
farShift = heading*-40
flick = floor(t*4 % 997)

draw {
  -- Lit roof edges on the near towers (Neon city's), by night
  for k < 17 {
    id = floor(nearShift/8) + k
    left = floor(id*8 + .9999 - nearShift)
    top = floor(hash(id%22, seed)*13 + 19.9999)
    line(left + 6, 31 - (top), left + 6, 31 - (top > 31 ? 20 : top), (k%2)*neonInk)
  }
  -- Gantries across the road and lamp posts beside it: 4 places, one
  -- every 14 stripes; a gantry at every third place
  for k < 4 {
    place = t/1.4 - k*-.25
    along = frac(place)
    ahead = 14.7 - along*14
    size = 1.2/ahead
    baseY = 11.5 + 12.5*size
    hw = 50.7*size*1.3
    roadX = 64 - (heading - noise(driven + ahead*.0075, 0, 0))*1200
    gantry = ahead < 11 and k%3 < 1
    post = ahead < 11 and k%3 > 0
    side = (k%2)*2 - 1
    topY = baseY - 26*size
    line(roadX - hw, topY, roadX + hw, topY, gantry*c.gantry)
    line(roadX - hw, topY, roadX - hw, baseY, gantry*c.gantry)
    line(roadX + hw, topY, roadX + hw, baseY, gantry*c.gantry)
    dot(roadX - 10*size, topY + 1, gantry*c.sign)
    dot(roadX + 10*size, topY + 1, gantry*c.sign)
    line(roadX + side*hw, baseY, roadX + side*hw, baseY - 20*size, post*c.barrierStripe)
    dot(roadX + side*hw, baseY - 20*size, post*(dark ? c.window : c.gantry))
  }
  -- The car
  for k < 17 {
    span = carSpan[k]/32
    rowInk = carRow[k]/16
    carY = floor(rowInk)
    line(floor(span) - carLeft, 31 - (carY), frac(span)*32 - carLeft, 31 - (carY), frac(rowInk))
  }
}

-- Rows: the road's half width (flat), the stripe, the bend at this depth;
-- above the horizon the sky's band; the towers by column (the run)
yu = 31 - py
below = yu < 19
depth = .1125 / (19.5 - (below ? yu : 39 - yu))
halfWidth = below*(50.7 - 2.6*yu)
phase = frac(39/max(halfWidth, 1.3) + t*10)
stripe = (phase < .5) * -c.step
offRoad = abs(px - (64 - (heading - noise(driven + depth, 0, 0))*1200))
sky = floor(skyBase - yu*skyStep) * c.step
windowRow = (yu - 20)/2 + yu%2*20
reflRow = (18 - yu)/2 + yu%2*20          -- the near row's windows, mirrored in the wet road
nearAt = px + nearShift
nearHeight = hash(floor(nearAt/8)%22, seed)*13
nearTop = (nearAt%8 < 7) * (19 + nearHeight)
farTop = max(19 + hash(seed, floor((px + farShift)/6))*9, nearTop)
windows = bit(42, nearAt%8)*floor(hash(floor(nearAt), seed)*127)
lit = bit(windows, windowRow)
refl = bit(windows, reflRow)*(yu < 10)
towers = (not below)*((yu < farTop) + (yu < nearTop) + lit)
-- The highway: 0 asphalt, 1 the dashed centre line, 2 the barrier, 3 the
-- city below it (its windows where the near row's are lit); the drawn
-- tags from 4; the reflection lightens the asphalt by night
m = max((offRoad >= halfWidth) + (offRoad >= halfWidth*1.12) + (offRoad < 1)*(stripe < 0)*(offRoad < halfWidth), ink(32))
el = pick(m + towers,
    below ? c.asphalt - stripe : sky, below ? c.lane : farInk, c.barrier - stripe, below ? c.below : winInk,
    c.gantry, c.barrierStripe, c.sign, c.car, c.glass, c.red, c.window, neonInk)
belowLit = below*(c.belowWin - c.below)
pal(c, el + (m < 1)*refl*reflInk + (m == 3)*lit*belowLit)
